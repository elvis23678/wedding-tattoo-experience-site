PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://...
JWT_SECRET=INSERISCI_UNA_CHIAVE_LUNGA_E_CASUALE
ADMIN_PASSWORD=INSERISCI_PASSWORD_ADMIN_CLOUD
ALLOWED_ORIGIN=https://www.weddingtattooexperience.it

PAYMENT_WEBHOOK_SECRET=change-me-with-a-long-random-secret

# Facoltativo: abilita la spiegazione AI del pacchetto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Invii automatici Fase 4.
OUTBOUND_EMAIL_WEBHOOK_URL=
OUTBOUND_WHATSAPP_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://www.weddingtattooexperience.it


# WTE V4 Punto 2 — Scheduler Engine
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
SCHEDULER_BATCH_SIZE=100
GUEST_CLOSE_DAYS_BEFORE_EVENT=15
BALANCE_DUE_DAYS_BEFORE_EVENT=7
ARCHIVE_DAYS_AFTER_EVENT=30
SCHEDULER_LOCK_SECONDS=900


# WTE V4 Punto 3 — Notification Engine
NOTIFICATION_DEFAULT_CHANNEL=auto
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_MINUTES=15
NOTIFICATION_BATCH_SIZE=50

# I due webhook devono accettare POST JSON e restituire JSON 2xx.
OUTBOUND_EMAIL_WEBHOOK_URL=
OUTBOUND_WHATSAPP_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=


# WTE V4 Punto 4 — PDF Engine
PDF_PUBLIC_BASE_URL=https://wte-cloud-api.onrender.com

# URL HTTPS pubblico del backend, usato per PDF e documenti.
PUBLIC_API_URL=https://wte-cloud-api.onrender.com


# WTE V4 — Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Release 1.0 Punto 3 — blocco temporaneo data
DATE_HOLD_MINUTES=30

# Release stabile pubblicata
WTE_RELEASE=1.0.0

# Release 1.0 Punto 5
RELEASE_MAINTENANCE_DEFAULT=false
